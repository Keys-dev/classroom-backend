# Database connection (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Better Auth secret (generate a random string for production)
BETTER_AUTH_SECRET=your-secret-key-here

# Frontend URL for CORS and trusted origins
FRONTEND_URL=http://localhost:5173

# Backend server port (optional, defaults to 8000)
PORT=8000

# Arcjet API key (optional, for rate limiting and bot protection)
# ARCJET_KEY=your-arcjet-key
# ARCJET_ENV=production
